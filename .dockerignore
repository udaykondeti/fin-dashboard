# Build context — only ship what the runtime image needs.
.git
.github
.claude

# Tests, docs shouldn't bloat the image.
# (scripts/ is intentionally NOT ignored — the Dockerfile COPYs it so seed /
# maintenance scripts can be invoked via `docker exec ... node /app/scripts/...`)
docs
*.md
LICENSE

# Local dev artefacts
node_modules
client/node_modules
client/dist
data
*.log

# Secrets — never bake into the image. Mounted from EC2 .env at runtime.
.env
.env.example
.env.local

# CI / infra not needed inside the container
ecosystem.config.js
nginx
