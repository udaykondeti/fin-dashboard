{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppUserFullAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:user/fin-dashboard-app"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:ListBucketVersions",
        "s3:GetObjectVersion",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::fin-kirakon-vault",
        "arn:aws:s3:::fin-kirakon-vault/*"
      ]
    },
    {
      "Sid": "CAUserReadOnlyAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:user/fin-ca-readonly"
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::fin-kirakon-vault/tax/*",
        "arn:aws:s3:::fin-kirakon-vault/statements/*",
        "arn:aws:s3:::fin-kirakon-vault/receipts/*"
      ]
    },
    {
      "Sid": "CAUserListBucket",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:user/fin-ca-readonly"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::fin-kirakon-vault",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tax/*",
            "statements/*",
            "receipts/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyCAUserDelete",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:user/fin-ca-readonly"
      },
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::fin-kirakon-vault",
        "arn:aws:s3:::fin-kirakon-vault/*"
      ]
    },
    {
      "Sid": "DenyPublicAccess",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::fin-kirakon-vault",
        "arn:aws:s3:::fin-kirakon-vault/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::ACCOUNT_ID:user/fin-dashboard-app",
            "arn:aws:iam::ACCOUNT_ID:user/fin-ca-readonly",
            "arn:aws:iam::ACCOUNT_ID:root"
          ]
        }
      }
    },
    {
      "Sid": "DenyNonHTTPS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::fin-kirakon-vault",
        "arn:aws:s3:::fin-kirakon-vault/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
