# Claude harness state (worktrees, transcripts)
.claude/

# Dependencies
node_modules/

# Environment variables (NEVER commit these)
.env
.env.local
.env.production

# Database
# *.db* rather than the three exact extensions: it also catches the timestamped
# copies left behind by migrations and backups (finance.db.retired-20260825-...,
# finance.db.stale-...), which the narrower patterns missed.
data/
*.db*

# Logs
*.log
logs/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Terraform state (contains secrets)
aws/terraform/.terraform/
aws/terraform/*.tfstate
aws/terraform/*.tfstate.backup
aws/terraform/.terraform.lock.hcl
