PORT=3001
JWT_SECRET=your-very-long-secret-key-here-change-in-production
DB_PATH=./data/finance.db
NODE_ENV=development

# Slack incoming webhook (kirakon app) — optional; outgoing notifications
SLACK_WEBHOOK_URL=

# ── Agent providers ──────────────────────────────────────────────────────
# Local model (Ollama) — PRIMARY when set. OpenAI-compatible endpoint.
# On the Mac Mini with Docker Desktop, the container reaches host Ollama via
# host.docker.internal. Leave blank to fall back to cloud providers.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# Anthropic API (cloud fallback — agent degrades gracefully if missing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Groq API (cloud fallback for general questions)
GROQ_API_KEY=
