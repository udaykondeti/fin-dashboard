PORT=3001
JWT_SECRET=your-very-long-secret-key-here-change-in-production
DB_PATH=./data/finance.db
NODE_ENV=development

# Slack incoming webhook (kirakon app) — optional; outgoing notifications
SLACK_WEBHOOK_URL=

# ── Agent providers ──────────────────────────────────────────────────────
# Local model — PRIMARY when set. OpenAI-compatible endpoint.
# Options:
#   - Direct local Ollama:    http://host.docker.internal:11434/v1
#   - Shared kirakon gateway: https://ai.kirakon.com/ollama/v1
#     (Open-WebUI on the Mac Mini at port 3004. Set OLLAMA_API_KEY too —
#     generate one in Open-WebUI → Settings → Account → API keys.)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=mistral
# Bearer token for authenticated endpoints (e.g. ai.kirakon.com). Leave
# blank for an unauthenticated local Ollama.
OLLAMA_API_KEY=

# Anthropic API (cloud fallback — agent degrades gracefully if missing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Local vault (file storage) ────────────────────────────────────────────
# Where uploaded files are stored. In Docker this is mounted from the host.
VAULT_PATH=/app/vault

# ── Gmail connector (optional) ────────────────────────────────────────────
# Create an OAuth app in Google Cloud Console → APIs & Services → Credentials
# Scopes needed: https://www.googleapis.com/auth/gmail.readonly
# Add GMAIL_REDIRECT_URI as an Authorised redirect URI in the OAuth client
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://fin.kirakon.com/api/gmail/callback
